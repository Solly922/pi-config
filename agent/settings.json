{
  "lastChangelogVersion": "0.86.0",
  "theme": "everforest-dark-hard",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "packages": [
    {
      "source": "git:github.com/DietrichGebert/ponytail",
      "extensions": [
        "+pi-extension/index.js"
      ]
    },
    "git:github.com/elpapi42/pi-observational-memory",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-web-access",
    "npm:@pi-lab/notify",
    "[disabled]---npm:@pi-archimedes/core",
    "npm:pi-paster",
    {
      "source": "npm:pi-zentui",
      "extensions": [
        "+extensions/zentui/index.ts"
      ]
    },
    "npm:pi-hermes-memory",
    "npm:@zosmaai/pi-llm-wiki",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-mcp-adapter",
    "npm:pi-git-commands",
    "npm:pi-ask-user",
    "npm:pi-rtk-optimizer",
    "git:https://github.com/elpapi42/pi-codegraph",
    "git:github.com/Leechael/pi-provider-kimi-code",
    {
      "source": "npm:pi-tool-display",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:pi-agent-browser-native",
    "npm:@victor-software-house/pi-curated-themes",
    "git:github.com/Solly922/pi-show-diffs@feature/change-descriptions",
    "npm:pi-openai-fast-mode",
    "git:github.com/Solly922/pi-meta-ai"
  ],
  "hideThinkingBlock": true,
  "observational-memory": {
    "observeAfterTokens": 20000,
    "reflectAfterTokens": 50000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.75,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "meta-ai",
      "id": "muse-spark-1.3-contributor",
      "thinking": "xhigh"
    },
    "passive": false,
    "debugLog": false
  }
}