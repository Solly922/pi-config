{
  "lastChangelogVersion": "1.0.3",
  "theme": "everforest-dark-hard",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "xhigh",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    {
      "source": "git:github.com/DietrichGebert/ponytail",
      "extensions": [
        "+pi-extension/index.js"
      ]
    },
    "git:github.com/elpapi42/pi-observational-memory",
    "npm:@tintinweb/pi-subagents",
    "npm:pi-web-access",
    "npm:@pi-lab/notify",
    "[disabled]---npm:@pi-archimedes/core",
    "npm:pi-paster",
    {
      "source": "npm:pi-zentui",
      "extensions": [
        "+extensions/zentui/index.ts"
      ]
    },
    "npm:pi-hermes-memory",
    {
      "source": "npm:@zosmaai/pi-llm-wiki",
      "prompts": [
        "!prompts/wiki-run.md"
      ]
    },
    "npm:@tintinweb/pi-tasks",
    "npm:pi-mcp-adapter",
    "npm:pi-git-commands",
    "npm:pi-ask-user",
    "npm:pi-rtk-optimizer",
    "git:https://github.com/elpapi42/pi-codegraph",
    "git:github.com/Leechael/pi-provider-kimi-code",
    {
      "source": "npm:pi-tool-display",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": []
    },
    "npm:@victor-software-house/pi-curated-themes",
    "git:github.com/Solly922/pi-show-diffs@feature/change-descriptions",
    "git:github.com/elidickinson/pi-claude-bridge@a78a2a5525e96318f8dba7f9fd32ce2191be0136",
    "npm:@earendil-works/pi-ai@0.87.1",
    "npm:@earendil-works/pi-coding-agent@0.87.1",
    "git:github.com/Solly922/pi-openai-fast-mode@feature/gpt-6-fast-mode",
    "git:github.com/Solly922/pi-jev-router@feature/fast-models"
  ],
  "hideThinkingBlock": false,
  "observational-memory": {
    "observeAfterTokens": 20000,
    "reflectAfterTokens": 50000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.75,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "openai-codex",
      "id": "gpt-6.1-sol",
      "thinking": "high"
    },
    "passive": false,
    "debugLog": false
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "tuiMode": "fullscreen"
}