    "npm:pi-web-access",
    "npm:@pi-lab/notify",
    "[disabled]---npm:@pi-archimedes/core",
    "npm:pi-paster",
    {
      "source": "npm:pi-zentui",
      "extensions": [
        "+extensions/zentui/index.ts"
      ]
    },
    "npm:pi-hermes-memory",
    {
      "source": "npm:@zosmaai/pi-llm-wiki",
      "prompts": [
        "!prompts/wiki-run.md"
      ]
    },
    "npm:@tintinweb/pi-tasks",
    "npm:pi-mcp-adapter",
    "npm:pi-git-commands",
    "npm:pi-ask-user",
    "npm:pi-rtk-optimizer",
    "git:https://github.com/elpapi42/pi-codegraph",
